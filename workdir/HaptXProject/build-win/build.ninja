# Object build statements for EXECUTABLE target yaml-cpp-sandbox


#############################################
# Order-only phony target for yaml-cpp-sandbox

build cmake_object_order_depends_target_yaml-cpp-sandbox: phony || cmake_object_order_depends_target_yaml-cpp

build _deps/yaml-cpp-build/util/CMakeFiles/yaml-cpp-sandbox.dir/sandbox.cpp.obj: CXX_COMPILER__yaml-cpp-sandbox_unscanned_Release /workdir/HaptXProject/build-win/_deps/yaml-cpp-src/util/sandbox.cpp || cmake_object_order_depends_target_yaml-cpp-sandbox
  DEFINES = -DYAML_CPP_STATIC_DEFINE
  FLAGS = /DWIN32 /D_WINDOWS /GR /EHsc /O2 /Ob2 /DNDEBUG -std:c++17 -MD
  INCLUDES = -I/workdir/HaptXProject/build-win/_deps/yaml-cpp-src/include
  OBJECT_DIR = _deps/yaml-cpp-build/util/CMakeFiles/yaml-cpp-sandbox.dir
  OBJECT_FILE_DIR = _deps/yaml-cpp-build/util/CMakeFiles/yaml-cpp-sandbox.dir
  TARGET_COMPILE_PDB = _deps/yaml-cpp-build/util/CMakeFiles/yaml-cpp-sandbox.dir/
  TARGET_PDB = _deps/yaml-cpp-build/util/sandbox.pdb


# =============================================================================
# Link build statements for EXECUTABLE target yaml-cpp-sandbox


#############################################
# Link the executable _deps/yaml-cpp-build/util/sandbox.exe

build _deps/yaml-cpp-build/util/sandbox.exe: CXX_EXECUTABLE_LINKER__yaml-cpp-sandbox_Release _deps/yaml-cpp-build/util/CMakeFiles/yaml-cpp-sandbox.dir/sandbox.cpp.obj | _deps/yaml-cpp-build/yaml-cpp.lib || _deps/yaml-cpp-build/yaml-cpp.lib
  FLAGS = /DWIN32 /D_WINDOWS /GR /EHsc /O2 /Ob2 /DNDEBUG -MD
  LINK_FLAGS = /machine:x64 /INCREMENTAL:NO /subsystem:console
  LINK_LIBRARIES = _deps/yaml-cpp-build/yaml-cpp.lib  kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib
  OBJECT_DIR = _deps/yaml-cpp-build/util/CMakeFiles/yaml-cpp-sandbox.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = _deps/yaml-cpp-build/util/CMakeFiles/yaml-cpp-sandbox.dir/
