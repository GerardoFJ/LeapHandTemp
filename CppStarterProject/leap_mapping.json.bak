{
  "_doc": [
    "Human (HaptX glove) -> LEAP Hand joint mapping, used by leap_teleop.py.",
    "This is the uncalibrated default; run leap_calibrate.py to replace it with one fitted to your hand.",
    "One entry per LEAP motor, in hardware ID order: index 0-3, middle 4-7, ring 8-11, thumb 12-15.",
    "LEAP target [rad, sim convention: 0 = flat] = gain * human[finger][channel] + offset,",
    "then clipped to the joint limits. The real hand adds pi on top (LEAP_Hand_API convention).",
    "Channels are AlternateHandIk's angles (flexion is negative, hence gain -1).",
    "The LEAP ring finger follows the human pinky."
  ],
  "smoothing": 0.35,
  "max_speed_rad_s": 8.0,
  "joints": [
    {"id": 0, "mjcf": "if_rot", "finger": "index", "channel": "add", "gain": 1.0, "offset": 0.0},
    {"id": 1, "mjcf": "if_mcp", "finger": "index", "channel": "mcp", "gain": -1.0, "offset": 0.0},
    {"id": 2, "mjcf": "if_pip", "finger": "index", "channel": "pip", "gain": -1.0, "offset": 0.0},
    {"id": 3, "mjcf": "if_dip", "finger": "index", "channel": "dip", "gain": -1.0, "offset": 0.0},

    {"id": 4, "mjcf": "mf_rot", "finger": "middle", "channel": "add", "gain": 1.0, "offset": 0.0},
    {"id": 5, "mjcf": "mf_mcp", "finger": "middle", "channel": "mcp", "gain": -1.0, "offset": 0.0},
    {"id": 6, "mjcf": "mf_pip", "finger": "middle", "channel": "pip", "gain": -1.0, "offset": 0.0},
    {"id": 7, "mjcf": "mf_dip", "finger": "middle", "channel": "dip", "gain": -1.0, "offset": 0.0},

    {"id": 8, "mjcf": "rf_rot", "finger": "pinky", "channel": "add", "gain": 1.0, "offset": 0.0},
    {"id": 9, "mjcf": "rf_mcp", "finger": "pinky", "channel": "mcp", "gain": -1.0, "offset": 0.0},
    {"id": 10, "mjcf": "rf_pip", "finger": "pinky", "channel": "pip", "gain": -1.0, "offset": 0.0},
    {"id": 11, "mjcf": "rf_dip", "finger": "pinky", "channel": "dip", "gain": -1.0, "offset": 0.0},

    {"id": 12, "mjcf": "th_cmc", "finger": "thumb", "channel": "add", "gain": 1.0, "offset": 0.0},
    {"id": 13, "mjcf": "th_axl", "finger": "thumb", "channel": "mcp", "gain": 0.0, "offset": 0.0},
    {"id": 14, "mjcf": "th_mcp", "finger": "thumb", "channel": "pip", "gain": -1.0, "offset": 0.0},
    {"id": 15, "mjcf": "th_ipl", "finger": "thumb", "channel": "dip", "gain": -1.0, "offset": 0.0}
  ]
}
